from ultralytics import YOLO
import cv2

# Load trained YOLO model
model = YOLO('drone_detector.pt')  # train and use an actual custom yolo model
camera = cv2.VideoCapture(0)

while True:
    ret, frame = camera.read()
    if not ret:
        break
    results = model(frame)
    cv2.imshow("Drone Detection", results[0].plot())
    if cv2.waitKey(1) & 0xFF == ord('q'):
        break

camera.release()
cv2.destroyAllWindows()
