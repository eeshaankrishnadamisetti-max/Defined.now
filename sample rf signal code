import time
import random
import numpy as np
import smtplib
from email.mime.text import MIMEText
import matplotlib.pyplot as plt
from matplotlib.animation import FuncAnimation

# ----- CONFIG -----
SAMPLE_INTERVAL = 0.1          # seconds between samples
THRESHOLD = 0.75               # detection threshold
EMAIL_COOLDOWN = 30            # seconds between alert emails
LOG_FILE = "signal_log.txt"

# Email Settings (update these)
SMTP_SERVER = "smtp.gmail.com"
SMTP_PORT = 587
SENDER_EMAIL = "@gmail.com"
SENDER_PASSWORD = "your_app_password"     # use Gmail app password
RECEIVER_EMAIL = "destination@gmail.com"

# ----- FUNCTIONS -----
def simulate_rf_signal():
    """Generate pseudo RF power with random drone spikes."""
    base = np.sin(time.time()) * 0.3 + 0.5
    noise = random.uniform(-0.1, 0.1)
    spike = random.uniform(0.4, 0.8) if random.random() < 0.05 else 0
    return min(max(base + noise + spike, 0), 1)

def log_signal(value, timestamp):
    """Log plain readings to a text file."""
    with open(LOG_FILE, "a") as f:
        f.write(f"{timestamp:.3f},{value:.4f}\n")

def send_email_alert(value):
    """Send email when a drone-like spike occurs."""
    body = (f"⚠ Drone-like RF signal detected!\n\n"
            f"Signal Strength: {value:.3f}\n"
            f"Time: {time.strftime('%Y-%m-%d %H:%M:%S')}")
    msg = MIMEText(body)
    msg["Subject"] = "Drone Detection Alert"
    msg["From"] = SENDER_EMAIL
    msg["To"] = RECEIVER_EMAIL

    try:
        with smtplib.SMTP(SMTP_SERVER, SMTP_PORT, timeout=10) as server:
            server.starttls()
            server.login(SENDER_EMAIL, SENDER_PASSWORD)
            server.send_message(msg)
        print("[EMAIL] Alert sent successfully!")
    except Exception as e:
        print(f"[EMAIL] Failed to send alert: {e}")

# ----- VISUAL SETUP -----
plt.style.use("dark_background")
fig, ax = plt.subplots(figsize=(8, 4))
ax.set_ylim(0, 1)
ax.set_xlim(0, 100)
ax.set_title("Drone RF Detection Simulation")
ax.set_xlabel("Samples")
ax.set_ylabel("Signal Strength (0–1)")
line, = ax.plot([], [], color="lime", lw=2)
alert_text = ax.text(5, 0.9, "", color="red", fontsize=12)

signal_values = []
last_email_time = 0

# ----- UPDATE LOOP -----
def update(frame):
    global last_email_time
    timestamp = time.time()
    value = simulate_rf_signal()
    log_signal(value, timestamp)

    signal_values.append(value)
    if len(signal_values) > 100:
        signal_values.pop(0)

    line.set_data(range(len(signal_values)), signal_values)

    if value > THRESHOLD:
        alert_text.set_text("⚠ Drone Signal Detected!")
        ax.set_facecolor("#330000")
        if time.time() - last_email_time > EMAIL_COOLDOWN:
            send_email_alert(value)
            last_email_time = time.time()
    else:
        alert_text.set_text("")
        ax.set_facecolor("black")

    return line, alert_text

ani = FuncAnimation(fig, update, interval=SAMPLE_INTERVAL * 1000)
plt.tight_layout()
plt.show()
